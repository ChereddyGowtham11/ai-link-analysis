OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
BRAVE_SEARCH_API_KEY=
COMPETITOR_RESEARCH=off
ANALYSIS_PER_DAY=120
ANALYSIS_PER_MINUTE=12
ANALYSIS_PER_CALLER_PER_MINUTE=5
ANALYSIS_MAX_IN_FLIGHT=3
# Optional verified rates for the selected model. See docs/LLM_COMPARISON.md.
# LLM_PRICE_MODEL=gemini-3.1-flash-lite
# LLM_INPUT_USD_PER_MILLION=0.25
# LLM_OUTPUT_USD_PER_MILLION=1.50
LLM_TIMEOUT_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
MAX_WEBSITE_CHARS=16000
MAX_CRAWL_PAGES=4
LOG_LEVEL=INFO
